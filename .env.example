# Copy to .env and fill in. .env is gitignored; this file is not.

# LLM ---------------------------------------------------------------------
# deepseek | fake  (use "fake" for offline runs and tests)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Tuning ------------------------------------------------------------------
# TOP_N=12
# PREFILTER_N=30
# MAX_PER_SOURCE=2
# MAX_AGE_DAYS=4
# NEAR_DUP_THRESHOLD=3
# LLM_BATCH_SIZE=8
# FETCH_CONCURRENCY=6
# PER_SOURCE_LIMIT=10

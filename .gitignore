# python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# env
.venv/
.env

# runtime
data/
*.db
*.db-wal
*.db-shm
.pytest_cache/
.ruff_cache/

# generated output -- keep the folder, drop the artefacts
public/*
!public/.gitkeep

# eval: generated artefacts (cases and labels are committed; per-run reports are not)
# '*' rather than the directory, so the one file worth keeping can be re-included.
eval/reports/*
!eval/reports/summary.md
eval/label-*.html

# IDE
.idea/
*.iml

# repo-local toolchain (PowerShell 7 portable, 256MB)
.tools/
.cache/
